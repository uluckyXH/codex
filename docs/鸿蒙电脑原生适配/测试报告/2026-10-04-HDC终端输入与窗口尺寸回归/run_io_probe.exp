#!/usr/bin/expect -f
set timeout 20
lassign $argv hdc target remote_program output_log window_mode
log_file -noappend $output_log
if {$window_mode eq "before-spawn"} {
    set stty_init "rows 36 columns 120"
}
spawn -noecho $hdc -t $target shell
puts "expect_slave_name=$spawn_out(slave,name)"
if {$window_mode eq "after-spawn"} {
    stty rows 36 columns 120 < $spawn_out(slave,name)
}
puts "expect_slave_size=[stty size < $spawn_out(slave,name)]"
expect {
    -re {[$#] ?$} {}
    timeout { exit 124 }
    eof { exit 125 }
}
send -- "$remote_program; terminal_probe_status=\$?; printf '\\n__TERMINAL_PROBE_EXIT__:%s\\n' \"\$terminal_probe_status\"; exit\r"
expect {
    -re {\r*\n__TERMINAL_INPUT_READY__\r*\n} { send -- "K" }
    timeout { close; exit 124 }
    eof { exit 125 }
}
expect {
    -re {\r*\n__TERMINAL_PROBE_EXIT__:([0-9]+)\r*\n} { set status $expect_out(1,string) }
    timeout { close; exit 124 }
    eof { exit 125 }
}
expect eof
exit $status
